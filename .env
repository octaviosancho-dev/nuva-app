# Publishable Supabase credentials. These ship inside the app bundle and are
# public by design — anyone with the app can read them. Row level security is
# what protects the data, not the secrecy of this key.
#
# NOTHING SECRET GOES IN THIS FILE. The service role key, Resend and RevenueCat
# secrets and anything else that grants privilege belong in `.env.local`, which
# `.gitignore` already excludes.
#
# Expo inlines EXPO_PUBLIC_* at build time.
EXPO_PUBLIC_SUPABASE_URL=https://bofhszpztmxeebwjhdxw.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ASXH0KDhVxEtUZFOnHse5A_W7jrdpT5

# PostHog project API key (phc_…). Public by design: it can only send events,
# never read them. The secret key (phs_…) must never be placed in this file.
EXPO_PUBLIC_POSTHOG_KEY=phc_vHW9izZsqiLx9NBhJwHXAs8hpJN3jseZB5EU9ygBksBb
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
